# Template per un deploy pubblico. NON e' il file che usa `docker compose up`:
# quello resta .env.example, pensato per lo sviluppo locale (APP_DEBUG=true e'
# corretto li', perche' l'ambiente non e' raggiungibile da Internet).
#
# Copia questo file come .env sull'host di produzione, compila i placeholder
# e non versionarlo. Vedi il Project Doc, sezione "Deploy pubblico" (Step D1),
# per la lista completa di cosa verificare prima del primo deploy.

APP_NAME=MEXAM
APP_ENV=production
APP_KEY=
# Una pagina di errore generica invece dello stack trace di Ignition: con
# APP_DEBUG=true su un dominio pubblico, qualunque eccezione non gestita
# mostra codice sorgente, percorsi e variabili d'ambiente a chiunque.
APP_DEBUG=false
APP_URL=https://tuo-dominio.example

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=mexam
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Senza, il cookie di sessione viaggia anche in chiaro su HTTP.
SESSION_SECURE_COOKIE=true
# Esplicito perche' da Laravel 13 il nome derivato dal default cambia
# (vedi Project Doc, Step 4/M4): fissarlo qui evita che l'aggiornamento
# invalidi le sessioni attive per un cambio di nome del cookie.
SESSION_COOKIE=mexam_session

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@tuo-dominio.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Niente bundle/renderer SSR ancora (Fase 2, Step F1): senza, l'adapter
# proverebbe a raggiungere un processo Node su INERTIA_SSR_URL che qui non
# esiste, e ogni pagina Inertia fallirebbe.
INERTIA_SSR_ENABLED=false

# Se davanti all'app c'e' un reverse proxy o una CDN che termina TLS (verifica
# la topologia reale prima del deploy), elenca qui gli IP/CIDR di quel proxy,
# separati da virgola. Vuoto = nessun proxy fidato (default sicuro, ma rompe
# la rilevazione di HTTPS/IP reale se un proxy c'e' davvero).
TRUSTED_PROXIES=

# Origini aggiuntive per le rotte api/* oltre ad APP_URL (che e' sempre
# incluso), separate da virgola. Lascia vuoto se il frontend e' servito dalla
# stessa app (Inertia): e' il caso previsto dalla Fase 2, Step F1+.
CORS_ALLOWED_ORIGINS=
