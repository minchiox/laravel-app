{
    "name": "MEXAM (Laravel · PHP 8.2)",

    // Riusa il compose di progetto invece di definire un'immagine a parte:
    // un solo posto da aggiornare, nessuna deriva tra `docker compose up` e
    // l'ambiente in cui si sviluppa.
    "dockerComposeFile": ["../docker-compose.yml"],
    "service": "app",
    "workspaceFolder": "/var/www",

    // Senza questo VS Code avvierebbe solo `app` e le sue dipendenze, quindi
    // nginx e phpMyAdmin resterebbero giu'.
    "runServices": ["app", "db", "webserver", "phpmyadmin"],

    // Il servizio deve restare vivo con il suo ENTRYPOINT (php-fpm): non va
    // sostituito con il comando "sleep infinity" di default.
    "overrideCommand": false,

    "remoteUser": "www",

    // Node solo qui dentro (layer aggiunto dal Dev Containers CLI *sopra*
    // l'immagine `app`, mai nel Dockerfile: il servizio `node` del compose e
    // l'immagine di produzione restano come prima). Serve perche' dentro
    // questo container non c'e' il CLI Docker (ne' l'accesso al socket
    // dell'host): senza Node qui, l'unico modo per lanciare Vite era un
    // secondo terminale sull'host per pilotare il servizio `node` via
    // `docker compose`/`make dev` — scomodo e per niente ovvio.
    "features": {
        "ghcr.io/devcontainers/features/node:1": { "version": "22" }
    },

    // A differenza di 8088/8181/33061 (che stanno in altri container e vanno
    // dichiarati come numeri nudi, come spiegato sotto), 5273 qui ha senso
    // forwardarla: e' Vite ad ascoltarci, dentro *questo* container, una
    // volta lanciato npm run dev.
    "forwardPorts": [5273],
    "portsAttributes": {
        "5273": { "label": "Vite (npm run dev)" }
    },

    // NIENTE altre forwardPorts.
    // I numeri nudi si riferiscono al container primario (`app`), che ascolta
    // solo su 9000 (e ora anche 5273, vedi sopra): dichiarare 8088/8181/33061
    // faceva ritentare a vuoto l'inoltro di porte su cui, in quel container,
    // non ascolta nessuno. Le porte sono gia' pubblicate sull'host dal compose:
    //   app  http://localhost:8088     phpMyAdmin  http://localhost:8181
    //   db   127.0.0.1:33061

    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "onecentlin.laravel-blade",
                "amiralizadeh9480.laravel-extra-intellisense",
                "EditorConfig.EditorConfig",
                "xdebug.php-debug"
            ],
            "settings": {
                "php.validate.executablePath": "/usr/local/bin/php",
                "intelephense.environment.phpVersion": "8.2",
                "files.eol": "\n",
                "emmet.includeLanguages": { "blade": "html" },
                "terminal.integrated.defaultProfile.linux": "bash",
                // vendor/ e' oltre 100 MB su bind mount: escluderlo dal
                // file watcher evita che VS Code ci lavori sopra all'avvio
                "files.watcherExclude": {
                    "**/vendor/**": true,
                    "**/node_modules/**": true,
                    "**/storage/framework/**": true,
                    "**/public/build/**": true
                }
            }
        }
    },

    // L'ENTRYPOINT del container ha gia' fatto composer install, migrazioni e
    // seed: qui basta assicurarsi che le dipendenze di sviluppo (PHP e, ora
    // che c'e' Node, anche JS) ci siano. node_modules finisce nel volume
    // anonimo gia' dichiarato su questo servizio in docker-compose.yml, non
    // sul bind mount: i binari compilati restano per Linux, non si mescolano
    // con quelli di un eventuale `npm install` fatto sull'host.
    "postCreateCommand": "composer install --no-interaction && npm install"
}
