[mysqld]
# general_log = 1 era attivo: MySQL scriveva su disco *ogni* query, non solo
# quelle lente. Utile per una sessione di debug, dannoso come default.
# Per riattivarlo temporaneamente:
#   SET GLOBAL general_log = 'ON';
general_log = 0

# Log delle query lente: questo si' che serve sempre.
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# --- Contenimento memoria ---
# Profilo da sviluppo: questo database convive con altri stack Docker sulla
# stessa macchina e il dataset e' minuscolo. Con i default MySQL 8 arriva
# facilmente a ~1.5 GB di RSS; qui si sta sotto i ~300 MB.
innodb_buffer_pool_size = 128M
innodb_log_buffer_size = 8M
key_buffer_size = 8M
max_connections = 50
performance_schema = OFF
