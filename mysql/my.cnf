[mysqld]
# general_log = 1 era attivo: MySQL scriveva su disco *ogni* query, non solo
# quelle lente. Utile per una sessione di debug, dannoso come default.
# Per riattivarlo temporaneamente:
#   SET GLOBAL general_log = 'ON';
general_log = 0

# Log delle query lente: questo si' che serve sempre.
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
