APP_NAME=MEXAM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# I valori sono gia' allineati ai servizi di docker-compose.yml:
# `db` e' il nome del servizio MySQL sulla rete interna.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=mexam
DB_USERNAME=mexam
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@mexam.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Porte esposte sull'host ---
# Volutamente non standard: 80, 8080, 9000, 6033 e 8081 sono spesso gia'
# occupate da altri progetti. Cambiale qui se collidono, senza toccare il
# docker-compose.yml.
APP_PORT=8088
DB_PORT_HOST=33061
VITE_PORT=5273
PMA_PORT=8181

# --- Docker ---
# Su Linux allinea questi valori a `id -u` / `id -g` per non ritrovarti file
# root-owned nel repo. Su macOS lasciali com'e'.
UID=1000
GID=1000

# Mettilo a false per avviare php-fpm senza composer install / migrate / seed
# automatici all'avvio del container.
MEXAM_AUTO_SETUP=true
